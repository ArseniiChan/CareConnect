# .dockerignore — files NOT to copy into the Docker build context.
# Reduces image size, speeds up builds, prevents secrets from leaking into images.

# Dependencies (rebuilt inside the container)
node_modules
frontend/node_modules

# Local environment files (NEVER ship secrets in an image)
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor noise
.DS_Store
Thumbs.db
.vscode
.idea
*.swp
structure.txt

# Docker (don't recurse into the compose / Dockerfiles themselves; the
# build context only needs source + deps + .env.example)
docker-compose.yml
frontend/Dockerfile
frontend/nginx.conf
frontend/.dockerignore

# Git
.git
.gitignore

# Frontend (the backend image does not need frontend source)
frontend

# Tests, docs, plan — none of this needs to be in the runtime image
# EXCEPT docs/swagger.yaml which the API serves at /api/docs
tests
docs/*
!docs/swagger.yaml
PROJECT_PLAN.md

# Build artifacts
dist
build
coverage

# Uploads (mounted as a volume in production, not baked in)
uploads/*
!uploads/.gitkeep
