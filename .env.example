# ===========================================
# CareConnect Backend Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# In Railway / Docker, set these as environment variables on the service
# (NOT by mounting a .env file). The container reads them from the
# environment at boot.

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Frontend origin (CORS + Socket.IO whitelist) ──────────────
# Accepts a single URL OR a comma-separated list. The backend reads
# FRONTEND_URL first (Docker/Railway convention); if not set it falls
# back to CORS_ORIGIN (legacy). Examples:
#   FRONTEND_URL=https://care-connect-omega-jade.vercel.app
#   FRONTEND_URL=https://prod.example.com,http://localhost:8080,http://localhost:5173
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Database (MySQL — hosted externally) ──────────────────────
# In production these point at Aiven. Locally they can point at a
# Docker mysql container, Aiven, or any other MySQL 8 host.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=careconnect
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT Authentication ────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server REFUSES to boot in production if this is missing or weak.
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY=7d

# ── File Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Marketplace economics ─────────────────────────────────────
# Platform service fee as a percentage of each completed booking.
# Used by sp_complete_appointment via PLATFORM_FEE_BPS (1 pct = 100 bps).
PLATFORM_FEE_PERCENT=20

# ── Geocoding ─────────────────────────────────────────────────
# Optional. Nominatim is keyless; this slot is reserved if we ever
# switch to Mapbox / Google Geocoding.
GEOCODING_API_KEY=

# ── Gemini (AI support chatbox) ───────────────────────────────
# Optional. If GEMINI_API_KEY is unset, the /api/v1/chat endpoint
# returns a 500 ("Gemini API key is not configured"). Leave blank in
# environments where the chatbox should not be available.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash 
