# Frontend environment variables
# Copy this file to `.env` and fill in the values for your local dev setup.
# Vercel env vars for deployed builds are set in the Vercel project settings UI,
# not from this file.

# Base URL of the deployed backend API.
# Local dev:        http://localhost:3000
# Railway deploy:   https://<your-railway-app>.up.railway.app
VITE_API_URL=http://localhost:3000
