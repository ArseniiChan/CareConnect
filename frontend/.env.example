# Frontend environment variables.
# Copy this file to `.env` for local Vite dev.
#
# In production:
#   - Vercel: set env vars in the Vercel project settings UI
#   - Railway (Docker): pass VITE_API_BASE_URL as a BUILD argument on the
#     frontend service (Vite inlines it at build time — runtime changes
#     have no effect)
#
# Only VITE_-prefixed variables are exposed to the client bundle. Never
# put secrets here; everything ends up in the JS that ships to browsers.

# Base URL of the deployed backend API.
# Local dev:               http://localhost:3000
# docker-compose:          http://localhost:3000  (backend service in compose)
# Railway / Vercel prod:   https://<your-backend>.up.railway.app
#
# VITE_API_BASE_URL is the canonical name. VITE_API_URL is supported as a
# fallback so existing Vercel deployments don't break.
VITE_API_BASE_URL=http://localhost:3000
