# Files NOT to copy into the frontend Docker build context.
#
# Vite rebuilds node_modules and dist inside the container, so we
# explicitly exclude them from the build context to keep uploads small
# and avoid the host's macOS/Linux node_modules mixing with the
# container's alpine ones.

# Dependencies — rebuilt inside the container by `npm ci`
node_modules

# Build artifacts — produced fresh by `npm run build` inside the container
dist
.vite

# Local env files — NEVER ship to an image
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git
.git
.gitignore

# OS / editor noise
.DS_Store
Thumbs.db
.vscode
.idea
*.swp
